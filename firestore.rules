rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Catch-all Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Auth & Identity Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() && request.auth.token.email == 'shivaminfotech89@gmail.com';
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // --- Entity Validation Helpers ---

    function isValidJob(data) {
      return data.jobNo is string && data.jobNo.size() >= 1 && data.jobNo.size() <= 50 &&
             data.mrNo is string && data.mrNo.size() >= 1 && data.mrNo.size() <= 50 &&
             data.capacityKva is number &&
             data.make is string && data.make.size() >= 1 && data.make.size() <= 100 &&
             data.serialNo is string && data.serialNo.size() >= 1 && data.serialNo.size() <= 100 &&
             data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 &&
             (!('dateOfIssue' in data) || (data.dateOfIssue is string && data.dateOfIssue.size() <= 30)) &&
             (!('type' in data) || (data.type is string && data.type.size() <= 50)) &&
             (!('repairType' in data) || (data.repairType is string && data.repairType.size() <= 50)) &&
             (!('division' in data) || (data.division is string && data.division.size() <= 100)) &&
             (!('coreType' in data) || (data.coreType is string && data.coreType.size() <= 50)) &&
             (!('status' in data) || (data.status is string && data.status.size() <= 50)) &&
             (!('isClosed' in data) || (data.isClosed is bool)) &&
             (!('atId' in data) || (data.atId is string && data.atId.size() <= 128)) &&
             (!('agencyId' in data) || (data.agencyId is string && data.agencyId.size() <= 128)) &&
             (!('testingDetails' in data) || (data.testingDetails is map)) &&
             (!('testingDate' in data) || (data.testingDate is string && data.testingDate.size() <= 50)) &&
             (!('challanNo' in data) || (data.challanNo is string && data.challanNo.size() <= 50)) &&
             (!('challanDate' in data) || (data.challanDate is string && data.challanDate.size() <= 50)) &&
             (!('vehicleNo' in data) || (data.vehicleNo is string && data.vehicleNo.size() <= 50)) &&
             (!('deliveryDate' in data) || (data.deliveryDate is string && data.deliveryDate.size() <= 50));
    }

    function isValidInspection(data) {
      return data.jobId is string && data.jobId.size() >= 1 && data.jobId.size() <= 128 &&
             data.type is string && data.type.size() >= 1 && data.type.size() <= 20 && (data.type == 'External' || data.type == 'Internal') &&
             data.data is map &&
             data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128;
    }

    function isValidAgency(data) {
      return data.name is string && data.name.size() >= 1 && data.name.size() <= 150 &&
             data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 &&
             (!('address' in data) || (data.address is string && data.address.size() <= 500)) &&
             (!('contact' in data) || (data.contact is string && data.contact.size() <= 100)) &&
             (!('email' in data) || (data.email is string && data.email.size() <= 150)) &&
             (!('atNumber' in data) || (data.atNumber is string && data.atNumber.size() <= 100)) &&
             (!('gstin' in data) || (data.gstin is string && data.gstin.size() <= 50)) &&
             (!('bankDetails' in data) || (data.bankDetails is string && data.bankDetails.size() <= 500)) &&
             (!('prefixes' in data) || (data.prefixes is map)) &&
             (!('lastJobNumbers' in data) || (data.lastJobNumbers is map)) &&
             (!('divisions' in data) || (data.divisions is list)) &&
             (!('estimateMaster' in data) || (data.estimateMaster is list)) &&
             (!('estimateMasterCRGO' in data) || (data.estimateMasterCRGO is list)) &&
             (!('estimateMasterAmorphous' in data) || (data.estimateMasterAmorphous is list)) &&
             (!('estimateMasterWoundCore' in data) || (data.estimateMasterWoundCore is list));
    }

    function isValidAtMaster(data) {
      return data.atNumber is string && data.atNumber.size() >= 1 && data.atNumber.size() <= 100 &&
             data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 &&
             (!('workOrderNo' in data) || (data.workOrderNo is string && data.workOrderNo.size() <= 100)) &&
             (!('dateOfAgreement' in data) || (data.dateOfAgreement is string && data.dateOfAgreement.size() <= 50)) &&
             (!('agencyId' in data) || (data.agencyId is string && data.agencyId.size() <= 128)) &&
             (!('prefixes' in data) || (data.prefixes is map)) &&
             (!('lastJobNumbers' in data) || (data.lastJobNumbers is map));
    }

    function isValidOilTransaction(data) {
      return data.agencyId is string && data.agencyId.size() >= 1 && data.agencyId.size() <= 128 &&
             data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 &&
             data.mrNo is string && data.mrNo.size() >= 1 && data.mrNo.size() <= 50 &&
             data.division is string && data.division.size() >= 1 && data.division.size() <= 100 &&
             data.grossLiters is number &&
             (!('mrDate' in data) || (data.mrDate is string && data.mrDate.size() <= 50)) &&
             (!('oilType' in data) || (data.oilType is string && data.oilType.size() <= 50)) &&
             (!('barrels' in data) || (data.barrels is number)) &&
             (!('filtrationLossPercent' in data) || (data.filtrationLossPercent is number)) &&
             (!('netLiters' in data) || (data.netLiters is number));
    }

    function isValidSupportTicket(data) {
      return data.ticketNo is string && data.ticketNo.size() >= 1 && data.ticketNo.size() <= 50 &&
             data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.userEmail is string && data.userEmail.size() >= 1 && data.userEmail.size() <= 150 &&
             data.subject is string && data.subject.size() >= 1 && data.subject.size() <= 200 &&
             data.description is string && data.description.size() >= 1 && data.description.size() <= 5000 &&
             (!('agencyId' in data) || (data.agencyId is string && data.agencyId.size() <= 128)) &&
             (!('agencyName' in data) || (data.agencyName is string && data.agencyName.size() <= 150)) &&
             (!('category' in data) || (data.category is string && data.category.size() <= 50)) &&
             (!('priority' in data) || (data.priority is string && data.priority.size() <= 50)) &&
             (!('status' in data) || (data.status is string && data.status.size() <= 50)) &&
             (!('adminReply' in data) || (data.adminReply is string && data.adminReply.size() <= 5000)) &&
             (!('repliedBy' in data) || (data.repliedBy is string && data.repliedBy.size() <= 150));
    }

    function isValidUserRole(data) {
      return data.email is string && data.email.size() >= 1 && data.email.size() <= 150 &&
             data.role is string && data.role.size() >= 1 && data.role.size() <= 50 &&
             (!('agencyId' in data) || (data.agencyId is string && data.agencyId.size() <= 128)) &&
             (!('agencyName' in data) || (data.agencyName is string && data.agencyName.size() <= 150)) &&
             (!('status' in data) || (data.status is string && data.status.size() <= 50)) &&
             (!('updatedBy' in data) || (data.updatedBy is string && data.updatedBy.size() <= 150));
    }

    // --- Match Rules ---

    match /jobs/{jobId} {
      allow get, list: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isSuperAdmin());
      allow create: if isSignedIn() && (incoming().ownerId == request.auth.uid || isSuperAdmin()) && isValidJob(incoming());
      allow update: if isSignedIn() && (existing().ownerId == request.auth.uid || isSuperAdmin()) && incoming().ownerId == existing().ownerId && isValidJob(incoming());
      allow delete: if isSignedIn() && (existing().ownerId == request.auth.uid || isSuperAdmin());
    }

    match /inspections/{inspectionId} {
      allow get, list: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isSuperAdmin());
      allow create: if isSignedIn() && (incoming().ownerId == request.auth.uid || isSuperAdmin()) && isValidInspection(incoming());
      allow update: if isSignedIn() && (existing().ownerId == request.auth.uid || isSuperAdmin()) && incoming().ownerId == existing().ownerId && isValidInspection(incoming());
      allow delete: if isSignedIn() && (existing().ownerId == request.auth.uid || isSuperAdmin());
    }

    match /agencies/{agencyId} {
      allow get, list: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isSuperAdmin());
      allow create: if isSignedIn() && (incoming().ownerId == request.auth.uid || isSuperAdmin()) && isValidAgency(incoming());
      allow update: if isSignedIn() && (existing().ownerId == request.auth.uid || isSuperAdmin()) && incoming().ownerId == existing().ownerId && isValidAgency(incoming());
      allow delete: if isSignedIn() && (existing().ownerId == request.auth.uid || isSuperAdmin());
    }

    match /atMasters/{atMasterId} {
      allow get, list: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isSuperAdmin());
      allow create: if isSignedIn() && (incoming().ownerId == request.auth.uid || isSuperAdmin()) && isValidAtMaster(incoming());
      allow update: if isSignedIn() && (existing().ownerId == request.auth.uid || isSuperAdmin()) && incoming().ownerId == existing().ownerId && isValidAtMaster(incoming());
      allow delete: if isSignedIn() && (existing().ownerId == request.auth.uid || isSuperAdmin());
    }

    match /oilTransactions/{txId} {
      allow get, list: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isSuperAdmin());
      allow create: if isSignedIn() && (incoming().ownerId == request.auth.uid || isSuperAdmin()) && isValidOilTransaction(incoming());
      allow update: if isSignedIn() && (existing().ownerId == request.auth.uid || isSuperAdmin()) && incoming().ownerId == existing().ownerId && isValidOilTransaction(incoming());
      allow delete: if isSignedIn() && (existing().ownerId == request.auth.uid || isSuperAdmin());
    }

    match /support_tickets/{ticketId} {
      allow get, list: if isSignedIn() && (resource.data.userId == request.auth.uid || isSuperAdmin());
      allow create: if isSignedIn() && (incoming().userId == request.auth.uid || isSuperAdmin()) && isValidSupportTicket(incoming());
      allow update: if isSignedIn() && ((existing().userId == request.auth.uid && incoming().userId == existing().userId) || isSuperAdmin()) && isValidSupportTicket(incoming());
      allow delete: if isSuperAdmin();
    }

    match /user_roles/{roleId} {
      allow get, list: if isSignedIn();
      allow create, update: if isSuperAdmin() && isValidUserRole(incoming());
      allow delete: if isSuperAdmin();
    }

    match /system_config/{configId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSuperAdmin();
    }
  }
}
