rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    match /jobs/{jobId} {
      allow read: if isSignedIn() && (existing().ownerId == request.auth.uid || !('ownerId' in existing()));
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && incoming().ownerId == request.auth.uid;
      allow update: if isSignedIn() && (incoming().ownerId == request.auth.uid || !('ownerId' in existing()));
      allow delete: if isSignedIn() && (existing().ownerId == request.auth.uid || !('ownerId' in existing()));
    }

    match /inspections/{inspectionId} {
      allow read: if isSignedIn() && (existing().ownerId == request.auth.uid || !('ownerId' in existing()));
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && incoming().ownerId == request.auth.uid;
      allow update: if isSignedIn() && (incoming().ownerId == request.auth.uid || !('ownerId' in existing()));
      allow delete: if isSignedIn() && (existing().ownerId == request.auth.uid || !('ownerId' in existing()));
    }

    match /agencies/{agencyId} {
      allow read: if isSignedIn() && (existing().ownerId == request.auth.uid || !('ownerId' in existing()));
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && incoming().ownerId == request.auth.uid;
      allow update: if isSignedIn() && (incoming().ownerId == request.auth.uid || !('ownerId' in existing()));
      allow delete: if isSignedIn() && (existing().ownerId == request.auth.uid || !('ownerId' in existing()));
    }

    match /atMasters/{atMasterId} {
      allow read: if isSignedIn() && (existing().ownerId == request.auth.uid || !('ownerId' in existing()));
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && incoming().ownerId == request.auth.uid;
      allow update: if isSignedIn() && (incoming().ownerId == request.auth.uid || !('ownerId' in existing()));
      allow delete: if isSignedIn() && (existing().ownerId == request.auth.uid || !('ownerId' in existing()));
    }

    match /oilTransactions/{txId} {
      allow read: if isSignedIn() && (existing().ownerId == request.auth.uid || !('ownerId' in existing()));
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && incoming().ownerId == request.auth.uid;
      allow update: if isSignedIn() && (incoming().ownerId == request.auth.uid || !('ownerId' in existing()));
      allow delete: if isSignedIn() && (existing().ownerId == request.auth.uid || !('ownerId' in existing()));
    }
  }
}
