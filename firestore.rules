rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() && request.auth.token.email == 'shivaminfotech89@gmail.com';
    }

    match /jobs/{jobId} {
      allow read, write: if isSignedIn();
    }

    match /inspections/{inspectionId} {
      allow read, write: if isSignedIn();
    }

    match /agencies/{agencyId} {
      allow read, write: if isSignedIn();
    }

    match /atMasters/{atMasterId} {
      allow read, write: if isSignedIn();
    }

    match /oilTransactions/{txId} {
      allow read, write: if isSignedIn();
    }

    match /user_roles/{roleId} {
      allow read, list: if isSignedIn();
      allow create, update, delete: if isSuperAdmin();
    }

    match /support_tickets/{ticketId} {
      allow create: if isSignedIn();
      allow read, list, update, delete: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || isSuperAdmin());
    }

    match /system_config/{configId} {
      allow read, list: if isSignedIn();
      allow create, update, delete: if isSuperAdmin();
    }
  }
}

